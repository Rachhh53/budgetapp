# Copy to .env for local development. Never commit .env.
# The installed app needs none of these: the desktop shell sets what the backend requires.

# --- Backend (read by app.budget.server.Config) ---

# Interface to listen on. Loopback only, unless phone access is turned on.
BUDGET_BIND_HOST=127.0.0.1

# First port to try; the next free one is used if it is taken.
BUDGET_PORT=4873

# Where the database, logs, backups and attachments live.
# Defaults to %APPDATA%\Budget (~/Library/Application Support/Budget on a Mac). Point development
# somewhere else so real data is never touched.
BUDGET_DATA_DIR=.dev-data

# Extra host names to accept in the Host header, comma separated (IP addresses and
# "localhost" are always accepted). Leave empty unless you reach the app by a DNS name.
BUDGET_ALLOWED_HOSTS=

# Largest receipt or document that can be attached, in megabytes (1 to 200). Defaults to 25.
BUDGET_MAX_UPLOAD_MB=25

# Folder the PDF export reads its fonts from (Segoe UI, then Arial). Defaults to the PC's own
# fonts folder (%WINDIR%\Fonts; /System/Library/Fonts/Supplemental on a Mac); without either
# font the export uses the built-in Helvetica.
# BUDGET_FONTS_DIR=

# Where a report export or a copy of a receipt is saved when it is asked for from this PC.
# Defaults to the Downloads folder of whoever runs the app (%USERPROFILE%\Downloads; ~/Downloads on a Mac).
# BUDGET_DOWNLOADS_DIR=

# Set by the desktop shell only — leave unset in development:
# BUDGET_PARENT_PID=        process id to watch; the backend exits when it does
# BUDGET_SHUTDOWN_TOKEN=    per-launch secret required by POST /api/shutdown

# --- Frontend dev server (read by frontend/vite.config.ts) ---

# Where `npm run dev` forwards /api requests: the address the backend printed in READY.
VITE_API_PROXY_TARGET=http://127.0.0.1:4873
