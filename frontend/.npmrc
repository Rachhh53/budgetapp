# Exact versions only, so a fresh install can never pull in something unreviewed.
save-exact=true
# Privacy: npm itself should not phone home during installs either.
fund=false
update-notifier=false
# Never install a version published in the last 14 days: too new for a hijacked or
# vulnerable release to have been noticed. CI enforces the same rule (check-dependency-age.ps1).
min-release-age=14
